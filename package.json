{
  "name": "tradewind-dealflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && npm run test:render",
    "test:unit": "node --experimental-strip-types --test tests/domain.test.ts tests/schema-storage.test.ts tests/csv-ingestion.test.ts tests/qualification.test.ts tests/dashboard.test.ts tests/ingestion-control.test.ts tests/massgis.test.ts tests/ingestion-runner.test.ts tests/ingestion-import.test.ts tests/legacy-asset-manifest.test.mjs tests/legacy-contracts.test.ts tests/underwriting-reference.test.ts tests/inspect-legacy-dealflow.test.mjs tests/migration-reconciliation.test.ts",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "legacy:manifest": "node scripts/legacy-asset-manifest.mjs",
    "legacy:inspect": "node scripts/inspect-legacy-dealflow.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .worktrees/**/dist"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "drizzle-kit": "0.31.10",
    "miniflare": "4.20260722.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
